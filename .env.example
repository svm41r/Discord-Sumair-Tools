# Discord Bot Credentials
DISCORD_TOKEN=your_bot_token_here

# Target Server (Guild) ID for instantaneous slash command sync
GUILD_ID=123456789012345678

# Sumair Tools API Authentication
LICENSE_API_KEY=your_sumair_tools_api_key_here
LICENSE_API_URL=https://sumairtools.online/api/v1/licenses/verify

# Optional: Set to 'true' to allow simulated mock keys (e.g. SUMAIR-PRO-TEST-1234) for local testing
ENABLE_MOCK_LICENSES=true

# Brand Palette (Hex values)
BRAND_PRIMARY_COLOR=0xFF4B4B
